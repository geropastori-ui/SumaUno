# URL del proyecto de Supabase (Project Settings → API).
# En local, la imprime `npx supabase start` (http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (publishable / anon). Es segura para el navegador porque RLS protege los datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública de la app, usada en los redirects de auth y en los links compartidos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo para scripts locales (seed de usuarios demo). Nunca la expongas en el cliente ni en Vercel como NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth para Supabase Auth local (supabase/config.toml). En producción se configura en el dashboard.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
